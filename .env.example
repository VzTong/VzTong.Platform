# Copy file này thành .env và điền giá trị thật (file .env không được commit)

ConnectionStrings__Default=Host=ep-winter-sunset-azmezjzl-pooler.c-3.ap-southeast-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
App__SelfUrl=https://localhost:44300
App__CorsOrigins=http://localhost:5173,http://localhost:3000

# OpenIddict (public client ids / URLs — không phải secret, nhưng nên cấu hình theo môi trường)
OpenIddict__Applications__Identity_Swagger__ClientId=Identity_Swagger
OpenIddict__Applications__Identity_Swagger__RootUrl=https://localhost:44322

OpenIddict__Applications__DocForge_Web__ClientId=DocForge_Web
OpenIddict__Applications__DocForge_Web__RootUrl=http://localhost:5173